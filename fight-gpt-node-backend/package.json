{
  "name": "fight-gpt-node-backend",
  "version": "1.0.1",
  "description": "Fight GPT API Gateway - Express.js backend with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --skipLibCheck",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "discord": "tsx src/discord/bot.ts",
    "test": "node run-jest.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "seed:sf6": "tsx src/seeders/seedSF6.ts",
    "seed:tekken8": "tsx src/seeders/seedTekken8.ts",
    "seed:game-metadata": "tsx src/seeders/seedGameMetadata.ts",
    "seed:character-encyclopedia": "tsx src/seeders/seedCharacterEncyclopedia.ts",
    "validate:seeder": "tsx src/seeders/validateSeeder.ts",
    "migrate:character-encyclopedia": "tsx src/seeders/migrateCharacterEncyclopedia.ts migrate",
    "validate:character-encyclopedia": "tsx src/seeders/validateCharacterEncyclopedia.ts",
    "scrape:sf6": "tsx src/scripts/scrapeSF6.ts",
    "seed:missions": "tsx src/seeders/seedMissions.ts",
    "reset:data": "tsx src/scripts/resetData.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "api-gateway",
    "fighting-games"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.53.1",
    "@types/multer": "^2.1.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "discord.js": "^14.26.4",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "resend": "^6.10.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
